{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "node"]
  },
  // Типчек идёт от входных точек по графу импортов: неиспользуемые
  // shadcn-компоненты в components/ui не проверяются, пока их не подключат.
  "files": ["src/main.tsx", "playwright.config.ts", "e2e/frontend-backend.spec.ts"]
}
