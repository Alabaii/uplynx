# Отдельный образ для browser-воркера: официальная база Playwright
# уже содержит Chromium и системные зависимости (в python:3.12-slim
# `playwright install --with-deps` ломается на переименованных пакетах Debian).
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# от root не работаем: этот контейнер запускает Chromium на страницах, которые
# выбирает арендатор, — самая враждебная поверхность в системе, и до сих пор
# единственная привилегированная (backend-образ давно ходит под appuser).
# pwuser приходит с базовым образом Playwright, браузеры в /ms-playwright
# доступны ему на чтение. Пользователь назначается после COPY, поэтому код
# остаётся за root — контейнер не может переписать сам себя.
USER pwuser

CMD ["python", "-m", "app.workers.browser_worker"]
