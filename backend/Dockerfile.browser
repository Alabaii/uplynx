# Отдельный образ для browser-воркера: официальная база Playwright
# уже содержит Chromium и системные зависимости (в python:3.12-slim
# `playwright install --with-deps` ломается на переименованных пакетах Debian).
FROM mcr.microsoft.com/playwright/python:v1.49.1-noble

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["python", "-m", "app.workers.browser_worker"]
