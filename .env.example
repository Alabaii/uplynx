# PostgreSQL
POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor

# JWT-секрет для подписи access-токенов. Обязательно замените в production —
# при ENVIRONMENT=production приложение не стартует с дефолтным значением.
JWT_SECRET_KEY=change-me-change-me

# development | production: в production запрещены дефолтные JWT-секреты
ENVIRONMENT=development

# Comma-separated список origin'ов фронтенда для CORS
CORS_ORIGINS=http://localhost:5173

# Fernet-ключ для шифрования секретов (Telegram bot token) at-rest.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если пусто — ключ детерминированно деривируется из JWT_SECRET_KEY (sha256 -> urlsafe_b64).
SECRET_ENCRYPTION_KEY=

# Режим развёртывания: team (лимиты ниже) | enterprise (без лимитов)
DEPLOYMENT_MODE=team
TEAM_MAX_USERS=20
TEAM_MAX_MONITORS=100

# Количество одновременных браузерных проверок
BROWSER_CONCURRENCY=2

# Web push (VAPID). Generate keys with: python -m app.tools.vapid; empty = push disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (SMTP) ---
# Пусто - email-канал отключён: сброс пароля и email-алерты просто не отправляются (это нормально)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PWA Monitor <no-reply@localhost>
SMTP_STARTTLS=true
# Базовый URL приложения для ссылок в письмах (страница /reset-password и т.п.)
APP_BASE_URL=http://localhost:5173

# Браузерные сценарии. Выключены по умолчанию: у их воркера нет пиннинга адреса —
# Chromium резолвит имя сам, поэтому DNS rebinding на шаге goto срабатывает, а
# редиректы и click идут вообще мимо проверки. Включать после изоляции воркера
# (CDP-перехват или egress-прокси), либо на on-prem, где это легитимно.
BROWSER_MONITORS_ENABLED=false

# Базовый адрес Telegram Bot API. Меняйте, только если api.telegram.org недоступен
# с сервера (например, закрыт маршрутом у провайдера): укажите свой reverse-proxy,
# и через посредника пойдёт ТОЛЬКО Telegram — проверки мониторов останутся прямыми.
# Через прокси проходит токен бота, поэтому используйте исключительно свой.
TELEGRAM_API_BASE=https://api.telegram.org
