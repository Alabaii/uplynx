# Кеширующий резолвер для воркеров (сервис resolver в docker-compose.yml).
#
# Без него КАЖДАЯ проверка резолвит имя заново — pin_target на каждом хопе
# редиректа плюс отдельный резолв под срок сертификата, то есть 2-7 запросов
# наружу на один чек. Любой потерянный UDP-пакет или подвисший апстрим даёт
# gaierror, а services/checks.py трактует его как down: приходил алерт
# «cannot resolve host» по живому сайту, и сразу по многим мониторам.
#
# Кеш отвечает изнутри docker-сети в пределах TTL, назначенного владельцем
# домена, — то есть монитор видит ровно тот адрес, что и посетители сайта.
.:53 {
    errors

    cache 3600 {
        # TTL записи соблюдается как есть: третий параметр (MINTTL) не задаём,
        # иначе цель с коротким TTL — а короткий TTL обычно и ставят под failover —
        # держалась бы у нас дольше, чем решил её владелец
        success 4096 3600
        denial 1024 300
        # мониторинг спрашивает одни и те же имена постоянно: обновляем запись
        # заранее, до истечения TTL, чтобы проверка не ждала похода к апстриму.
        # Это повышает свежесть записи, а не продлевает ей жизнь
        prefetch 5 60m 10%
        # serve_stale здесь НЕ используется осознанно: отдавать адрес за
        # пределами TTL — значит проверять цель по адресу, который ей может уже
        # не принадлежать, и показывать аптайм, которого нет. Временный сбой
        # резолва лечится ретраем в core/ssrf.py, а не подменой адреса
    }

    # порядок фиксированный, неотвечающий апстрим исключается health_check-ом.
    # Список правится под провайдера: часть публичных резолверов бывает недоступна
    forward . 8.8.8.8 1.1.1.1 77.88.8.8 9.9.9.9 {
        policy sequential
        max_fails 2
        health_check 5s
    }

    # в лог идут только сбойные ответы: успешный резолв на каждой проверке — шум
    log . {
        class error
    }
}
